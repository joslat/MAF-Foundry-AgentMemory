# Copy to local-memory/.env and fill in. .env is gitignored.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=maf-foundry-demo   # local-only default, matches local-memory/docker-compose.yml; change both if you expose Neo4j

# Azure OpenAI (same Foundry resource that hosts the agents)
AI_INFERENCE_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=<your-chat-model-deployment>        # e.g. gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your-embedding-deployment>  # e.g. text-embedding-3-small (1536 dims)

# MCP host
AGENT_MEMORY_MCP_TRANSPORT=http
AGENT_MEMORY_MCP_URL=http://localhost:5233
AGENT_MEMORY_MCP_OWNER=foundry-demo

# Optional: run the checked-out host instead of the global tool (path to the .csproj).
# AGENT_MEMORY_MCP_HOST_PROJECT=C:\git\joslat\agent-memory-dotnet\tools\AgentMemory.McpHost\AgentMemory.McpHost.csproj

# Demo: broader recall so plainly worded questions still hit (library default 0.7).
AGENT_MEMORY_MCP_MIN_SIMILARITY=0.5
