# Local run only (gitignored). In Foundry these come from azure.yaml env + `azd env set`.
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=<your-chat-model-deployment>   # e.g. gpt-5-mini
ASPNETCORE_URLS=http://+:8088
AZURE_TOKEN_CREDENTIALS=dev

# Memory host: local while developing, the https tunnel root URL (no /mcp) when hosted.
MEMORY_MCP_URL=http://localhost:5233/
MEMORY_TUNNEL_TOKEN=
